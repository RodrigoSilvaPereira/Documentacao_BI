{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main capability",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:default",

    "dialog:default",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",

    "fs:default",
    "fs:read-all",

    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },

    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-remove",

    "updater:default",
    "process:default"
  ]
}