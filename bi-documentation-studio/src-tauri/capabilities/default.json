{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:fs:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:dialog:default",

    "core:fs:allow-read-text-file",
    "core:fs:allow-write-text-file",
    "core:fs:allow-exists",
    "core:fs:allow-read-dir",
    "core:fs:allow-copy-file",
    "core:fs:allow-rename",
    "core:fs:allow-remove",

    "core:dialog:allow-open",
    "core:dialog:allow-save"
  ]
}