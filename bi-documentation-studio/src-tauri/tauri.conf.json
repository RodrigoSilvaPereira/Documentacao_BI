{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BI Documentation Studio",
  "version": "2.0.2",
  "identifier": "com.bidocstudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BI Documentation Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxRjBFRTgyQ0NDQjM2MzEKUldReE5zdk1ndTd3Z1U1R3hDbW9LdTg3NTlFblBPVnBsR0VRU0p1TW1vTU9vTnp5UzhINWZLdkIK",
      "endpoints": [
        "https://github.com/RodrigoSilvaPereira/Documentacao_BI/releases/latest/download/latest.json"
      ]
    }
  }
}